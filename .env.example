NODE_ENV=production
PORT=3010

# PostgreSQL can use DATABASE_URL, or the PG_* fields below.
DATABASE_URL=postgresql://molingapi:change-me@127.0.0.1:5432/molingapi
PG_SSLMODE=disable

# Must be 32 bytes encoded as 64 hex characters. Generate with:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
MODEL_RELAY_MASTER_KEY=
MODEL_RELAY_INTERNAL_TOKEN=
MODEL_RELAY_ADMIN_TOKEN=
MODEL_RELAY_USER_SIGNING_KEY=
MODEL_RELAY_PUBLIC_BASE_URL=http://127.0.0.1:3010

# Development only. Production exits if PostgreSQL is unavailable.
MODEL_RELAY_ALLOW_MEMORY=false
